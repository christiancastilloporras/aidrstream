# --- KOI API Configuration ---
# KOI API base URL (default is production)
KOI_API_URL=https://api.prod.koi.security/api/external/v2

# KOI API key (Bearer token) - create in KOI Settings > API Access > Create New API Key
KOI_API_KEY=your_koi_api_key_here

# --- XSIAM HTTP Collector Configuration ---
# XSIAM HTTP collector endpoint URL
XSIAM_URL=https://api-{tenant_external_url}/logs/v1/event

# XSIAM API key ID (numeric identifier, sent as x-xdr-auth-id header)
XSIAM_API_KEY_ID=your_xsiam_api_key_id_here

# XSIAM HTTP collector API key secret (sent as Authorization header)
XSIAM_API_KEY=your_xsiam_api_key_here

# --- Poller Configuration ---
# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# Page size for KOI API requests (default: 100, max: 500)
KOI_PAGE_SIZE=100